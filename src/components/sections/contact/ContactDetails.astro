---
// components
import Container from "../../elements/Container.astro"
import ContactItem from "./ContactItem.astro"
import { profile } from "../../../data/portfolio";
---
<Container variant={'md'}>
    <div class="flex lg:flex-row flex-col gap-8 text-base-900">
        <ContactItem title="Email" contact={profile.email} href={`mailto:${profile.email}`} />
        <ContactItem title="Phone" contact={profile.phoneDisplay} href={`tel:${profile.phone}`} />
    </div>
</Container>