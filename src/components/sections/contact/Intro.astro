---
// components
import Heading from "../../elements/Heading.astro";
import Container from "../../elements/Container.astro";
import Text from "../../elements/Text.astro";
---

<Container variant={'xl'} class="text-center text-base-900 flex flex-col items-center">
    <Heading tagName="h1" tagSize="h1">Contact</Heading>
    <div class="max-w-3xl flex flex-col gap-4">
        <Text variant={'xl'}>Let's Build Something Useful Together!</Text>
        <Text variant={'sm'}>Have a junior backend or full-stack opportunity? I'd love to hear about your team, the problems you're solving and how I can contribute.</Text>
        <Text variant={'sm'}>Based in Johannesburg, South Africa, with experience working in a remote engineering team.</Text>
    </div>
</Container>