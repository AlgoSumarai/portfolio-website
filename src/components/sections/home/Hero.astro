---
// components
import Container from "../../elements/Container.astro"
import Text from "../../elements/Text.astro"
import Heading from "../../elements/Heading.astro"
import ImageContainer from "../../elements/ImageContainer.astro"
import Link from "../../elements/Link.astro"

// assets
import portrait from "../../../assets/images/profile/graduation.png";
import { profile } from "../../../data/portfolio";
---

<Container variant={"xl"} class="flex flex-col gap-8 min-h-screen">
    <Text variant={'xl'} class="text-base-900 lg:max-w-1/3 md:max-w-1/2 w-full">Hey there! I'm a junior software engineer in Johannesburg expirienced in building useful software with C# / .NET, PHP / Laravel, SQL and React / TypeScript.</Text>
    <Container class="flex md:flex-row flex-col gap-8">
        <Container class="md:flex-2 flex flex-col items-start gap-4">
            <Link variant={'button'} href="/contact">Available for work</Link>
            <Heading tagName="h1" tagSize="h1">{profile.displayName}</Heading>
        </Container>
        <Container class="h-full md:h-[500px] flex-1">
            <ImageContainer src={portrait} alt="Sennelo Mulanga Gundo at his University of Johannesburg graduation" />
        </Container>
    </Container>
</Container>

